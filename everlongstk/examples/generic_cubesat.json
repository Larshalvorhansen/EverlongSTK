              "field": "storage_used_bytes",
              "op": "<",
              "value": {
                "value": 800000000,
                "unit": "byte",
                "certainty": "guesstimate",
                "note": "Synthetic illustrative CubeSat input, not a hardware specification"
              }
            }
          ]
        },
        "actions": {
